{
  "name": "testfold",
  "version": "0.4.3",
  "packageManager": "npm@11.19.1",
  "description": "Unified test runner with Jest and Playwright support, parallel execution, and detailed failure reporting",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "testfold": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc && node scripts/ensure-cli-executable.mjs",
    "test": "node tests/scripts/run-all-tests.js",
    "test:unit": "node tests/scripts/run-unit-tests.js",
    "test:integration": "node tests/scripts/run-integration-tests.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:workflows": "node scripts/check-workflows.mjs",
    "pack:check": "npm run build && node scripts/check-package.mjs",
    "verify": "npm run build && npm run lint && npm test && npm run test:integration && npm run check:workflows && node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "test",
    "runner",
    "jest",
    "playwright",
    "testing",
    "parallel",
    "reporter"
  ],
  "author": "Mike",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witqq/testfold.git"
  },
  "homepage": "https://github.com/witqq/testfold#readme",
  "bugs": {
    "url": "https://github.com/witqq/testfold/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "minimist": "^1.2.8",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "yaml": "2.9.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "test-exclude": {
      "glob": "^13.0.6"
    }
  }
}
